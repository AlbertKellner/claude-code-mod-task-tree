+// O painel do app desktop montado, para ler se ele virou o aviso de painel grande e apertar o botão
+// do aviso, como a pessoa faz (o harness não vê a pintura nem o clique de verdade: checklist do app).
+const AVISO = 'Painel grande demais'
+const LONGO = 'com um título comprido, como os de uma sessão real, que passa da largura do painel'
+const mostradoNoApp = (el: any): string => (typeof el === 'string' ? el : (el?.children ?? []).map(mostradoNoApp).join(''))
+async function noApp($: any) {
+  const ui = await $.ui.mount({ plugin: 'task-tree', surface: 'desktop', component: 'Pane', props: PROPS(60), requestId: 'task-tree' })
+  const ler = async () => {
+    const raiz = await ui.drawn()
+    return { aviso: mostradoNoApp(raiz).includes(AVISO), kb: Math.round(JSON.stringify(raiz).length / 1024) }
+  }
+  return { ler, voltar: () => ui.press({ key: 'back' }), fim: () => ui.unmount() }
+}
+
+// Regra: cabecalho.aviso-de-painel-grande-volta
+test('o aviso de painel grande, depois de abrir "+N pedidos anteriores", volta ao painel com eles fechados', { timeoutMs: 15000 }, async ($: any, on: any) => {
+  const { relogio } = fixar(on)
+  host(on, [])
+  // Um pedido antigo de 1 + 8 + 64 + 320 linhas de títulos longos (com o resto, abaixo das 400 do
+  // desenho), todas concluídas com tempo, fora do trabalho.
+  const antigo: No[] = grande('U', 8, 8, 5).map(a => ({ ...a, children: (a.children ?? []).map(b => ({ ...b, title: `${b.title} ${LONGO}`, children: (b.children ?? []).map(c => ({ ...c, title: `${c.title} ${LONGO}` })) })) }))
+  const folhas = antigo.flatMap(a => (a.children ?? []).flatMap(b => (b.children ?? []).map(c => c.id)))
+  await pedido($, 'Pedido um')
+  await plan($, antigo)
+  await start($, folhas)
+  await relogio.advance(65000)
+  await done($, folhas)
+  await fimDoTurno($)
+  await relogio.advance(1000)
+  await pedido($, 'Pedido dois')
+  await plan($, [{ id: 'P', title: 'Plano pequeno', children: [{ id: 'p1', title: 'Pequeno um' }, { id: 'p2', title: 'Pequeno dois' }] }])
+  await start($, ['p1'])
+  // Fechado, o histórico cabe; aberto, o desenho passa do limite e o painel vira o aviso.
+  const app = await noApp($)
+  let d = await app.ler()
+  expect(d.aviso, `${d.kb} KB com o histórico fechado`).toBe(false)
+  await comHistorico($, 1)
+  d = await app.ler()
+  expect(d.aviso, `${d.kb} KB com o histórico aberto: o pedido antigo precisa passar de 600 KB`).toBe(true)
+  // O botão fecha o histórico aberto e o painel normal volta.
+  await app.voltar()
+  d = await app.ler()
+  expect(d.aviso, `${d.kb} KB depois de voltar`).toBe(false)
+  await app.fim()
+  const p = await painel($)
+  expect(p.some(l => l.titulo === '+1 pedidos anteriores' && l.texto.startsWith('▸')), emTexto(p)).toBe(true)
+  expect(p.some(l => l.titulo === 'U0'), emTexto(p)).toBe(false)
+  esperarEstado(p, 'Pequeno um', 'andamento')
+})
