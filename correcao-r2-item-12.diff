+// O painel do app desktop montado: se virou o aviso de painel grande, o tamanho do desenho e o texto
+// alternativo de cada linha (o harness não vê a pintura: checklist do app).
+const AVISO = 'Painel grande demais'
+const LIMITE = 600 * 1024
+const LONGO = 'com um título comprido, como os de uma sessão real, que passa da largura do painel'
+const mostradoNoApp = (el: any): string => (typeof el === 'string' ? el : (el?.children ?? []).map(mostradoNoApp).join(''))
+const altsNoApp = (el: any): string[] => (typeof el !== 'object' || el === null ? [] : [...(el.type === 'Svg' ? [String(el.props?.alt ?? '')] : []), ...(el.children ?? []).flatMap(altsNoApp)])
+async function noApp($: any) {
+  const ui = await $.ui.mount({ plugin: 'task-tree', surface: 'desktop', component: 'Pane', props: PROPS(60), requestId: 'task-tree' })
+  const raiz = await ui.drawn()
+  await ui.unmount()
+  const alts = altsNoApp(raiz)
+  // A linha que conta o que o corte tirou do começo, e a que conta o que tirou do fim do último pedido.
+  return { aviso: mostradoNoApp(raiz).includes(AVISO), bytes: JSON.stringify(raiz).length, alts, antes: alts.find(a => /\+\d+ linhas anteriores$/.test(a)), depois: alts.find(a => /\+\d+ linhas$/.test(a)) }
+}
+const kb = (d: { bytes: number }) => `${Math.round(d.bytes / 1024)} KB`
+// "Pedido um": 1 + 8 + 64 + 320 linhas de títulos longos, todas as folhas iniciadas e com tempo; `abertas`
+// delas ficam abertas, as outras concluídas. São menos de 400 linhas e mais de 600 KB no app desktop: o
+// corte que os testes abaixo veem é o do tamanho, não o das 400 linhas.
+async function pedidoPesado($: any, relogio: any, abertas: number) {
+  const plano: No[] = grande('U', 8, 8, 5).map(a => ({ ...a, children: (a.children ?? []).map(b => ({ ...b, title: `${b.title} ${LONGO}`, children: (b.children ?? []).map(c => ({ ...c, title: `${c.title} ${LONGO}` })) })) }))
+  const folhas = plano.flatMap(a => (a.children ?? []).flatMap(b => (b.children ?? []).map(c => c.id)))
+  await pedido($, 'Pedido um')
+  await plan($, plano)
+  await start($, folhas)
+  await relogio.advance(65000)
+  await done($, folhas.slice(0, folhas.length - abertas))
+}
+// "Pedido dois", pequeno, depois do fim do turno do pedido um.
+async function pedidoPequeno($: any, relogio: any) {
+  await fimDoTurno($)
+  await relogio.advance(1000)
+  await pedido($, 'Pedido dois')
+  await plan($, [{ id: 'P', title: 'Plano pequeno', children: [{ id: 'p1', title: 'Pequeno um' }, { id: 'p2', title: 'Pequeno dois' }] }])
+  await start($, ['p1'])
+}
+
+// Regra: cabecalho.limite-de-linhas-do-desenho
+test('sem nada aberto, um desenho acima de 600 KB perde os pedidos mais antigos até caber, sem aviso', { timeoutMs: 15000 }, async ($: any, on: any) => {
+  const { relogio } = fixar(on)
+  host(on, [])
+  // Uma folha do pedido um segue aberta: os dois pedidos ficam à vista, sem a pessoa abrir nada.
+  await pedidoPesado($, relogio, 1)
+  await pedidoPequeno($, relogio)
+  let d = await noApp($)
+  expect(d.aviso, kb(d)).toBe(false)
+  expect(d.bytes, kb(d)).toBeLessThanOrEqual(LIMITE)
+  expect(d.antes, d.alts.slice(0, 3).join('\n')).toBeDefined()
+  expect(d.alts.some(a => a.includes('Pequeno um')), d.alts.slice(-5).join('\n')).toBe(true)
+  // Um segundo depois (o relógio redesenha o painel), o corte é o mesmo.
+  const antes = d.antes
+  await relogio.advance(1000)
+  d = await noApp($)
+  expect(d.aviso, kb(d)).toBe(false)
+  expect(d.antes, d.alts.slice(0, 3).join('\n')).toBe(antes)
+  // O terminal, bem abaixo do limite, segue com o desenho inteiro.
+  const p = await painel($)
+  expect(p.some(l => l.texto.includes('linhas anteriores')), emTexto(p).slice(0, 300)).toBe(false)
+})
