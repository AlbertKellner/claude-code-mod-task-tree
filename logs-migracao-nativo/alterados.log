## task-tree/tests/ultracode.test.ts::ultra_effort_enter acende a palavra no cabeçalho e no arquivo publicado; ultra_effort_exit apaga
regras: ultracode.so-o-interruptor-real, ultracode.cabecalho; selo: decisao, 2026-11-13, migração para o desenho nativo: leitura do app por key, texto e alt; decisão do usuário, 2026-11-13; asserções 5 → 5
  async ($: any, on: any) => {
      fixar(on);
      base(on);
      const h = host(on, []);
      await pedido($, 'Pedido um');
      await plan($, A);
      await start($, ['1']);
      expect(await topo($)).not.toContain('ultracode');
      await $.prompt.attachment(anexo('ultra_effort_enter'));
      expect(await topo($)).toContain('ultracode');
      await start($, ['1']);
      expect(h.proprio()?.ultracode).toBe(true);
      await $.prompt.attachment(anexo('ultra_effort_exit'));
      expect(await topo($)).not.toContain('ultracode');
      await start($, ['1']);
      expect(h.proprio()?.ultracode).toBeUndefined();
  }

