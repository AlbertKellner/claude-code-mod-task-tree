+// O fundo e a borda dos cartões no app desktop, lidos na árvore do desenho: o que a cor de cada um dá
+// sobre a superfície do painel, no tema escuro e no claro.
+
+// A superfície do painel no app, por tema (lida no app em 2026-11-13: #191919 no escuro, branco no claro).
+type Rgb = readonly number[]
+const PAINEL: Record<string, Rgb> = { escuro: [25, 25, 25], claro: [255, 255, 255] }
+// Uma cor crua e translúcida, a única que o app pinta igual nos dois temas e que muda os dois fundos.
+const CRUA = /^rgba\((\d+),(\d+),(\d+),(0?\.\d+)\)$/
+// O tom que o app pinta com a cor sobre `sob`; undefined se ela não é crua e translúcida (uma chave
+// de tema, nada).
+function sobre(cor: unknown, sob: Rgb): Rgb | undefined {
+  const m = typeof cor === 'string' ? CRUA.exec(cor) : null
+  if (!m) return undefined
+  return sob.map((v, i) => v + (Number(m[i + 1]) - v) * Number(m[4]))
+}
+// A maior distância entre dois tons, em níveis de 0 a 255.
+const niveis = (a: Rgb, b: Rgb) => Math.max(...a.map((v, i) => Math.abs(v - (b[i] ?? 0))))
+// Os cartões do desenho: o Box com borda dentro de cada Box key="c<i>", com o texto da linha que o
+// abre (r<i>) e quantos cartões há em volta dele.
+type CartaoDoApp = { titulo: string; dentro: number; fundo: unknown; borda: unknown }
+function cartoesDoApp(d: DesenhoDoApp): CartaoDoApp[] {
+  const out: CartaoDoApp[] = []
+  const andar = (x: any, dentro: number) => {
+    if (typeof x !== 'object' || x === null) return
+    const k = x.key ?? x.props?.key
+    const m = x.type === 'Box' && typeof k === 'string' ? /^c(\d+)$/.exec(k) : null
+    const caixa = m ? (x.children ?? []).find((c: any) => c?.props?.borderStyle !== undefined) : undefined
+    if (m && caixa) {
+      out.push({ titulo: d.linhas.find(l => l.key === `r${m[1]}`)?.texto ?? '', dentro, fundo: caixa.props.backgroundColor, borda: caixa.props.borderColor })
+      for (const c of caixa.children ?? []) andar(c, dentro + 1)
+      return
+    }
+    for (const c of x.children ?? []) andar(c, dentro)
+  }
+  andar(d.raiz, 0)
+  return out
+}
+// O cartão se destaca nos dois temas: o fundo (o dele ou, sem um, o do cartão de fora) a 5 níveis ou
+// mais do painel, e a borda a 20 ou mais do fundo.
+function esperarDestaque(c: CartaoDoApp, fundoDeFora?: unknown) {
+  for (const [tema, painel] of Object.entries(PAINEL)) {
+    const fundo = sobre(c.fundo ?? fundoDeFora, painel)
+    expect(fundo, `${c.titulo}: o fundo (${String(c.fundo ?? fundoDeFora)}) não é uma cor crua e translúcida`).toBeDefined()
+    expect(niveis(fundo!, painel), `${c.titulo}: o fundo contra o painel, no tema ${tema}`).toBeGreaterThanOrEqual(5)
+    const borda = sobre(c.borda, fundo!)
+    expect(borda, `${c.titulo}: a borda (${String(c.borda)}) não é uma cor crua e translúcida`).toBeDefined()
+    expect(niveis(borda!, fundo!), `${c.titulo}: a borda contra o fundo, no tema ${tema}`).toBeGreaterThanOrEqual(20)
+  }
+}
