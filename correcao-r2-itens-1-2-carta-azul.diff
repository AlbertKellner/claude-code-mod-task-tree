+// Regra: envios.cor-por-estado
+test('a carta de um plano interrompido segue azul enquanto está na fila e fica cinza na entrega', async ($: any, on: any) => {
+  const { relogio } = fixar(on)
+  const h = host(on, [{ id: 'local_x' }])
+  responderEnvio(on)
+  await pedido($, 'Pedido um')
+  await plan($, A)
+  await start($, ['1'])
+  await envio($, 'local_x')
+  await fimDoTurno($)
+  await relogio.advance(1000)
+  await pedido($, 'Pedido dois')
+  await plan($, [{ ...A[0]!, title: 'Plano A novo' }])
+  await aviso($)
+  let p = await painel($)
+  const cartas = (linhas: typeof p) => linhas.filter(l => l.titulo.startsWith('Para ') && l.carta !== undefined)
+  expect(cartas(p).map(l => l.carta), emTexto(p)).toEqual(['fila'])
+  expect(cartas(p)[0]!.texto).toContain('na fila')
+  h.recebeu('local_x', AGORA)
+  await aviso($)
+  p = await painel($)
+  expect(cartas(p).map(l => l.carta), emTexto(p)).toEqual(['interrompida'])
+})
+
